


RewriteEngine On
RewriteBase /

# Chuy?n yêu c?u không ph?i là t?p tin ho?c thu m?c d?n file có .php theo du?ng d?n g?c
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ $1.php [L,QSA]


Options -Indexes


# Thêm .IPA vào trang
AddType application/octet-stream .ipa
